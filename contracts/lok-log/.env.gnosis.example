# Official Gnosis (100) — copy to .env.gnosis (gitignored). Never commit real keys.
# Chiado: use RPC_URL=https://rpc.chiado.gnosis.gateway.fm and same role shape.
# Addresses only below — private keys are held by the operator and supplied at deploy time.

PRIVATE_KEY=          # ephemeral deployer EOA only (fund minimal xDAI; sweep after)
RPC_URL=https://rpc.gnosischain.com
# Public fallback (server rotation; forge uses RPC_URL primary):
#   https://gnosis-rpc.publicnode.com

# ─── Addresses / keys YOU must supply ───────────────────────────────────────
# | What              | Who                         | Env            | Status |
# |-------------------|-----------------------------|----------------|--------|
# | Safe multisig     | Admin + emergency/guardian  | ADMIN          | PENDING |
# | Treasury          | Fee recipient (≠ Safe)      | FEE_RECIPIENT  | PENDING |
# | Listing EOA       | Server openAsk/cancelAsk    | LISTING (+ pk in apps/server LOK_LISTING_KEY) | SET |
# | Rotator EOA       | Checkpoint signers          | ROTATOR        | SET |
# | Proposer EOA      | Ruleset propose             | PROPOSER       | SET |
# | Items (optional)  | Real Items.sol or 0x0       | ITEMS          | |
# LISTING / ROTATOR / PROPOSER must be pairwise distinct and ≠ ADMIN / FEE_RECIPIENT.

# Safe multisig — admin (+ default emergency/guardian) — PENDING from operator
ADMIN=
# EMERGENCY=   # optional, defaults to ADMIN
# GUARDIAN=    # optional, defaults to ADMIN

# Distinct treasury (not Safe, not server keys) — PENDING from operator
FEE_RECIPIENT=

# Distinct server EOAs (addresses fixed; keys supplied privately at deploy — never commit keys)
LISTING=0xbFa29a6EE3d1188aa0A9e0c783E5Da620b859E76
ROTATOR=0xD76040AC7aD29fEE8618ca911D04FEf2ec90B2dC
PROPOSER=0x82DC7FF0f2E199799a1028fE3c5702dF6Fe6f697

# Real Items.sol (DeployItems), or 0x000…000 to leave imports/exports off.
# Never MockItems on 100/10200. Dry-run deployments/gnosis.json Checkpoint→MockItems
# must never be used by a production server.
ITEMS=0x0000000000000000000000000000000000000000
KEK=0x0000000000000000000000000000000000000000

# DeployItems.s.sol extras (optional):
# ITEMS_BASE_URI=https://blackanvil.gg/items/
# CHECKPOINT=0x…          # grant MINTER_ROLE at Items deploy
# ITEMS_SEED_SLUGS=       # default: pnpm --filter @bellgrave/items print-seed

BASE_URI=https://legendofkek.com/character/
# 1 xDAI — DeployChiado default when unset
MINT_FEE=1000000000000000000

# Additive PvpBounty (1 xDAI head-bounty) — defaults match deployments/gnosis.json
# NFT=0x48aFeC17A56c5Bd32ABDbcAD57f16d3859b1289F
# ADMIN=0x08cDab8b049D2A42125C3A2bf1bF1E2f619C4e01
# LISTING=0xbFa29a6EE3d1188aa0A9e0c783E5Da620b859E76
# CONFIRM_BROADCAST=1 ./script/broadcast-deploy-pvp-bounty-gnosis.sh
