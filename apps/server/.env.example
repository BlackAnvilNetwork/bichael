# Settlement profile — one knob for chain / RPC / explorers / confirmations.
# gnosis (100) | chiado (10200) | anvil (31337). LOK_NETWORK is an alias.
NETWORK=anvil

# Process
PORT=8787
# LOK_DATA_DIR=./data
# AUTH_ORIGINS=http://localhost:5173
# AUTH_TRUST_PROXY=

# Explicit overrides (win over NETWORK profile defaults):
# LOK_CHAIN_ID=31337
# LOK_CHAIN_RPC=http://127.0.0.1:8545
# LOK_CHAIN_RPC_URLS=http://127.0.0.1:8545
# LOK_PUBLIC_RPC=http://127.0.0.1:8545
# LOK_CONFIRMATIONS=1
# LOK_EXPLORER=
# LOK_DEPLOY_BLOCK=
# LOK_WATCHER_LAG_ALERT_BLOCKS=50

# From local forge deploy (NETWORK=anvil fills from deployments/anvil.json):
# LOK_NFT=
# LOK_FACTORY=
# LOK_AH_ESCROW=
# LOK_PVP_BOUNTY=          # PvpBounty escrow (anvil: 0xA51c1fc2… via DeployPvpBountyAnvil)
# LOK_PVP_SYNTHETIC=       # 1 = invent receipts (tests); omit when LOK_PVP_BOUNTY is set
# LOK_CHECKPOINT=
# LOK_RULESETS=
# LOK_ITEMS=
# LOK_LISTING_KEY=         # OPERATOR for PvpBounty claim/cancel (anvil K0 auto-filled)

# Ops probes (same PORT): GET /health /ready /status
# Backup: ./scripts/backup-data-dir.sh

# Gnosis production: copy .env.gnosis.example → .env.local (never commit secrets)
