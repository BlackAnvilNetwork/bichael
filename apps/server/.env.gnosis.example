# Gnosis mainnet (100) production profile — copy to apps/server/.env.local (gitignored).
# NO SECRETS in git. Fill keys locally; never commit .env.local.
#
# Official stack: deployments/gnosis.json (2026-10-13). Dry-run is gnosis-dryrun.json only.
# NETWORK=gnosis fills blank LOK_* from that file. Never set LOK_ALLOW_DRY_RUN_DEPLOY=1 in prod.
# See docs/gnosis-launch.md + docs/pvp-ash-pit.md.

NETWORK=gnosis
# LOK_NETWORK=gnosis   # alias

# --- Process / data ---
PORT=8787
# LOK_DATA_DIR=./data
# AUTH_ORIGINS=https://blackanvil.gg,https://www.blackanvil.gg,https://play.blackanvil.gg
# AUTH_TRUST_PROXY=1

# --- Settlement RPC (intended production) ---
LOK_CHAIN_ID=100
LOK_CHAIN_RPC=https://rpc.gnosischain.com
LOK_CHAIN_RPC_URLS=https://rpc.gnosischain.com,https://gnosis-rpc.publicnode.com
LOK_PUBLIC_RPC=https://rpc.gnosischain.com
# LOK_CONFIRMATIONS=30
# LOK_USE_FINALIZED=1   # default on gnosis; set 0 to force tip-confirmations only
# REQUIRED on gnosis — Bearer for GET /status (loopback bypass disabled in production)
LOK_OPS_STATUS_TOKEN=
# LOK_EXPLORER=https://gnosisscan.io
# LOK_BLOCKSCOUT=https://gnosis.blockscout.com
# LOK_DEPLOY_JSON=../../deployments/gnosis.json
# LOK_DEPLOY_BLOCK=   # REQUIRED after official deploy (watcher backfill start)

# --- Ops ---
# LOK_WATCHER_LAG_ALERT_BLOCKS=50
# Probes (same PORT as WS): GET /health  GET /ready  GET /status
# Backup: LOK_DATA_DIR=./data BACKUP_ROOT=./backups ./scripts/backup-data-dir.sh

# --- Contract addresses (blank → load from deployments/gnosis.json) ---
# LOK_NFT=
# LOK_FACTORY=
# LOK_AH_ESCROW=
# LOK_PVP_BOUNTY=0x02bDDCaF5a19fD9Be7f39fC7419F794CECE9E64e  # 1 xDAI; auto-filled from gnosis.json
# LOK_CHECKPOINT=
# LOK_RULESETS=
# LOK_ITEMS=   # real Items.sol only — never MockItems

# --- Production server role addresses (keys held privately; supply at deploy — never commit keys) ---
# LISTING  0xbFa29a6EE3d1188aa0A9e0c783E5Da620b859E76  → AhEscrow LISTING + PvpBounty OPERATOR
# ROTATOR  0xD76040AC7aD29fEE8618ca911D04FEf2ec90B2dC  → Checkpoint signers (deploy env ROTATOR)
# PROPOSER 0x82DC7FF0f2E199799a1028fE3c5702dF6Fe6f697  → Ruleset propose (deploy env PROPOSER)
# ADMIN    0x08cDab8b049D2A42125C3A2bf1bF1E2f619C4e01  → PvpBounty DEFAULT_ADMIN / GUARDIAN
#
# Server runtime — LISTING EOA only (AH + PvpBounty OPERATOR). Never put ADMIN/owner keys here.
# Where this goes:
#   Local / single-host:  apps/server/.env.local  (this file’s copy; gitignored)
#   Production:           the Node process env for apps/server (PORT 8787) —
#                         host secret settings / systemd EnvironmentFile / panel
#                         env vars. Same variable name: LOK_LISTING_KEY.
# Do not set LOK_OWNER_KEY or PRIVATE_KEY on production (boot refuses).
LOK_LISTING_KEY=
# LOK_OWNER_KEY=   # do not set on production hosts

# --- Never on mainnet ---
# LOK_DEV_FAUCET=
# LOK_DEV_SERVER_MINT=
